# Overrides for this stack and ../demo. Copy to .env owner-only (install -m 600 .env.template .env) in the directory you run
# `docker compose` from, either this one or ../demo, and uncomment what you change; unset variables keep the defaults shown.
# The realm is imported on Keycloak's first boot only, so run `docker compose down -v` after changing ports, the realm or its credentials.

# Katta Server image, e.g. a locally built one
#KATTA_SERVER_IMAGE=ghcr.io/shift7-ch/katta-server:latest

#HUB_PORT=8280
#HUB_KEYCLOAK_HTTP_PORT=8380
#HUB_KEYCLOAK_REALM=cryptomator
# secrets of the cryptomatorhub-system and cryptomatorvaults clients
#HUB_KEYCLOAK_SYSTEM_CLIENT_SECRET=top-secret
#HUB_KEYCLOAK_OIDC_CRYPTOMATOR_VAULTS_CLIENT_SECRET=top-secret
# Hub's admin user in the realm
#HUB_ADMIN_USER=admin
#HUB_ADMIN_PASSWORD=admin

# The browser and Hub both reach MinIO at http://<MINIO_HOSTNAME>:<MINIO_PORT>, so the hostname must resolve to the loopback address
# on the host (any *.localhost name does) and the port is the same inside and outside the container.
#MINIO_HOSTNAME=minio.localhost
#MINIO_PORT=9100
#MINIO_CONSOLE_PORT=9101

# S3 and STS endpoints of further storage profiles the browser talks to directly, as space-separated CSP sources, e.g. https://*.wasabisys.com
#CSP_CONNECT_SRC_EXTRA=

# Initial license; unset or empty, Hub starts with the public test license with 5 seats
#HUB_INITIAL_ID=42
#HUB_INITIAL_LICENSE=
#HUB_LICENSE_CHAIN_REQUIRED_CN=Hub License Issuer CA (Test)
