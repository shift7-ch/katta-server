# Copy to .env owner-only (install -m 600 .env.template .env), since it will hold client secrets, and adjust.
# Docker Compose reads .env from this directory.

# Katta Server image, e.g. a locally built one
KATTA_SERVER_IMAGE=ghcr.io/shift7-ch/katta-server:latest

# Keycloak as the browser reaches it, without the /realms/... path
HUB_KEYCLOAK_PUBLIC_URL=https://kc.example.com
# Keycloak as Hub reaches it from inside the container, if different from the public URL
HUB_KEYCLOAK_LOCAL_URL=
HUB_KEYCLOAK_REALM=katta-hybrid
# secrets of the cryptomatorhub-system and cryptomatorvaults clients of that realm
HUB_KEYCLOAK_SYSTEM_CLIENT_SECRET=CHANGE-ME
HUB_KEYCLOAK_OIDC_CRYPTOMATOR_VAULTS_CLIENT_SECRET=CHANGE-ME

# S3 and STS endpoints of the storage profiles the browser talks to directly, as space-separated CSP sources, e.g. https://*.wasabisys.com
CSP_CONNECT_SRC_EXTRA=

