    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
