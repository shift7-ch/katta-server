    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.1",
    "@types/blueimp-md5": "^2.18.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.19.15",
    "@types/semver": "^7.7.1",
